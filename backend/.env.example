# Arquivo opcional. Copie para ".env" (mesma pasta) só se quiser mudar algum valor abaixo.
# O ".env" não vai para o Git. Formato: chave=valor, sem aspas.
# O banco de dados (H2 em memória) não precisa de configuração.

# ---------- Segurança ----------
# Texto aleatório com 32 caracteres ou mais. Em branco, a API gera uma chave a cada início.
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------- Assistente de IA ----------
# Chave da API Gemini (Google AI Studio). Em branco, o assistente devolve o roteiro padrão (sem IA).
GEMINI_API_KEY=
# Modelos tentados em ordem; os seguintes são reserva se o primeiro estiver sobrecarregado ou lento.
IA_MODELOS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3.1-flash-lite

# ---------- Base de demonstração ----------
SEED_ATIVO=true
SEED_SENHA=viaja123

# ---------- E-mail real (opcional) ----------
