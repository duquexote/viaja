# Copie este arquivo para ".env" (mesma pasta) e preencha. O ".env" não vai para o Git.
# Formato: chave=valor, sem aspas.

# ---------- Supabase (PostgreSQL) ----------
# No painel do Supabase: Connect > Session pooler. Use a porta 5432 (modo sessão).
# O usuário do pooler tem o formato postgres.<ref-do-projeto>.
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=SUA_SENHA_DO_BANCO
# Esquema onde as tabelas são criadas (fora do "public", que o Supabase expõe pela Data API)
DB_SCHEMA=viaja

# ---------- Segurança ----------
# Texto aleatório com 32 caracteres ou mais
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------- Assistente de IA ----------
# Chave da API da Anthropic. Em branco, o assistente devolve o roteiro padrão (sem IA).
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# ---------- Base de demonstração ----------
SEED_ATIVO=true
SEED_SENHA=viaja123

# ---------- E-mail real (opcional) ----------
